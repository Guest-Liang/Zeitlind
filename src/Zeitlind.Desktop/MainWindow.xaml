<Window
  x:Class="Zeitlind.Desktop.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Zeitlind · 成就导出"
  Width="850"
  Height="850"
  MinWidth="700"
  MinHeight="620"
  WindowStartupLocation="CenterScreen"
  Background="#F3F3F7"
  Foreground="{StaticResource TextBrush}"
  FontFamily="Segoe UI, Microsoft YaHei UI"
  FontSize="14"
  UseLayoutRounding="True"
  Loaded="Window_Loaded"
  Closing="Window_Closing"
>
  <Grid Margin="28,24,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Width="54" Height="54" CornerRadius="12" Background="{StaticResource AccentBrush}">
        <TextBlock
          Text="Z"
          FontSize="30"
          FontWeight="SemiBold"
          Foreground="White"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
        />
      </Border>
      <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="Zeitlind" FontSize="27" FontWeight="SemiBold" />
        <TextBlock
          Text="读取游戏成就，保存你的进度。"
          Foreground="{StaticResource SecondaryTextBrush}"
          Margin="0,3,0,0"
        />
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <TextBlock
          x:Name="VersionText"
          HorizontalAlignment="Right"
          Foreground="{StaticResource SecondaryTextBrush}"
        />
        <TextBlock
          Text="管理员"
          FontSize="12"
          Foreground="{StaticResource SecondaryTextBrush}"
          HorizontalAlignment="Right"
          Margin="0,5,0,0"
        />
      </StackPanel>
    </Grid>
    <ScrollViewer
      Grid.Row="1"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
      Padding="0,0,5,0"
    >
      <StackPanel>
        <StackPanel x:Name="GameActions">
          <Grid Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="选择游戏" FontSize="18" FontWeight="SemiBold" />
              <TextBlock
                Text="从米哈游启动器注册表读取 · 支持国服"
                FontSize="12"
                Foreground="{StaticResource SecondaryTextBrush}"
                Margin="0,4,0,0"
              />
            </StackPanel>
            <Button Content="刷新列表" HorizontalAlignment="Right" Click="Refresh_Click" />
          </Grid>
          <ItemsControl x:Name="GamesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                      Width="44"
                      Height="44"
                      CornerRadius="10"
                      Background="{Binding BadgeBackground}"
                      VerticalAlignment="Center"
                    >
                      <TextBlock
                        Text="{Binding Badge}"
                        Foreground="{Binding BadgeForeground}"
                        FontWeight="SemiBold"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                      />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock
                        Text="{Binding Detail}"
                        ToolTip="{Binding Detail}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        FontSize="12"
                        Margin="0,6,0,0"
                        TextTrimming="CharacterEllipsis"
                      />
                    </StackPanel>
                    <Button
                      Grid.Column="2"
                      Content="导出成就"
                      Style="{StaticResource PrimaryButtonStyle}"
                      VerticalAlignment="Center"
                      IsEnabled="{Binding IsAvailable}"
                      Click="Export_Click"
                      AutomationProperties.Name="{Binding ExportLabel}"
                    />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Style="{StaticResource CardStyle}" Margin="0,2,0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                <TextBlock
                  x:Name="ManualTitle"
                  Text="手动选择游戏"
                  FontSize="15"
                  FontWeight="SemiBold"
                />
                <TextBlock
                  x:Name="ManualDetail"
                  Text="进入游戏安装目录，选择游戏本体 EXE。"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  Margin="0,6,0,0"
                  FontSize="12"
                  TextWrapping="Wrap"
                />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="选择游戏 EXE…" Click="Browse_Click" />
                <Button
                  x:Name="ManualExportButton"
                  Content="导出成就"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Margin="0,8,0,0"
                  Visibility="Collapsed"
                  Click="ManualExport_Click"
                />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
        <Border Style="{StaticResource CardStyle}" Background="#F9FAFD" Margin="0,0,0,12">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0">
                <TextBlock
                  x:Name="StatusTitle"
                  Text="准备就绪"
                  FontWeight="SemiBold"
                  FontSize="15"
                  AutomationProperties.LiveSetting="Polite"
                />
                <TextBlock
                  x:Name="StatusDetail"
                  Text="点击导出后进入游戏；读取完成后，Zeitlind 会关闭本次启动的游戏。"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  TextWrapping="Wrap"
                  Margin="0,6,0,0"
                  FontSize="12"
                />
              </StackPanel>
              <Button
                x:Name="CancelButton"
                Grid.Column="1"
                Content="取消"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Click="Cancel_Click"
              />
            </Grid>
            <ProgressBar
              x:Name="ExportProgressBar"
              Height="4"
              IsIndeterminate="True"
              Visibility="Collapsed"
              Margin="0,15,0,0"
              Foreground="{StaticResource AccentBrush}"
            />
            <StackPanel x:Name="SavePanel" Visibility="Collapsed" Margin="0,18,0,0">
              <TextBlock Text="导出格式" FontSize="12" Margin="0,0,0,7" />
              <ComboBox
                x:Name="FormatSelector"
                DisplayMemberPath="Label"
                SelectedIndex="0"
                MinHeight="36"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="导出格式"
              />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                  x:Name="SaveButton"
                  Content="保存文件"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Click="Save_Click"
                />
                <Button
                  x:Name="OpenResultButton"
                  Grid.Column="1"
                  Content="打开输出目录"
                  Margin="10,0,0,0"
                  Visibility="Collapsed"
                  Click="OpenResult_Click"
                />
                <Button
                  x:Name="ResetButton"
                  Grid.Column="3"
                  Content="返回选择"
                  Click="Reset_Click"
                />
              </Grid>
              <TextBlock
                Text="文件保存在程序所在目录的 Exports 文件夹。"
                FontSize="12"
                Foreground="{StaticResource SecondaryTextBrush}"
                Margin="0,10,0,0"
              />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock
        Text="非官方工具：导出会向游戏加载临时 Hook，可能带来账号风险，请自行判断。"
        FontSize="11"
        Foreground="{StaticResource SecondaryTextBrush}"
        TextWrapping="Wrap"
      />
      <TextBlock
        Text="运行日志保存在程序目录，可能包含游戏路径与 UID；分享前请检查个人信息。"
        FontSize="11"
        Foreground="{StaticResource SecondaryTextBrush}"
        TextWrapping="Wrap"
        Margin="0,4,0,0"
      />
    </StackPanel>
  </Grid>
</Window>
