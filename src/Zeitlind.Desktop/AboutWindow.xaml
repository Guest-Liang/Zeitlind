<Window
  x:Class="Zeitlind.Desktop.AboutWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="关于与诊断"
  Width="500"
  SizeToContent="Height"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  Background="#F3F3F7"
  Foreground="{StaticResource TextBrush}"
  FontFamily="Segoe UI, Microsoft YaHei UI"
  FontSize="14"
  UseLayoutRounding="True"
>
  <StackPanel Margin="24">
    <TextBlock x:Name="BuildText" FontSize="20" FontWeight="SemiBold" />
    <TextBlock
      x:Name="CopyrightText"
      Foreground="{StaticResource SecondaryTextBrush}"
      Margin="0,6,0,0"
    />
    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
      <Run Text="原始仓库 " />
      <Hyperlink Click="Repository_Click" Foreground="{StaticResource AccentBrush}">
        <Run x:Name="RepositoryText" />
      </Hyperlink>
    </TextBlock>
    <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
      <StackPanel>
        <TextBlock Text="运行日志" FontWeight="SemiBold" />
        <TextBlock
          x:Name="LogPathText"
          Foreground="{StaticResource SecondaryTextBrush}"
          TextWrapping="Wrap"
          Margin="0,6,0,0"
        />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="OpenLogButton" Content="打开日志" IsEnabled="False" />
          <Button
            x:Name="CopyErrorButton"
            Content="复制最近错误"
            IsEnabled="False"
            Margin="8,0,0,0"
          />
        </StackPanel>
        <TextBlock
          x:Name="FeedbackText"
          Foreground="{StaticResource SecondaryTextBrush}"
          TextWrapping="Wrap"
          Margin="0,8,0,0"
          AutomationProperties.LiveSetting="Polite"
        />
      </StackPanel>
    </Border>
    <Button Content="关闭" IsCancel="True" HorizontalAlignment="Right" Margin="0,14,0,0" />
  </StackPanel>
</Window>
