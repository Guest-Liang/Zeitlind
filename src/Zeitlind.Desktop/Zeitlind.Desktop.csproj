<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Zeitlind.Desktop</AssemblyName>
    <RootNamespace>Zeitlind.Desktop</RootNamespace>
    <AssemblyTitle>Zeitlind 成就导出工具</AssemblyTitle>
    <Product>Zeitlind</Product>
    <Company>GuestLiang</Company>
    <Copyright>Copyright © 2026 GuestLiang</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- .NET 11 WPF mixed-mode assemblies need to load from disk. See dotnet/wpf#11842. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <NoWarn>$(NoWarn);NETSDK1244</NoWarn>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>zh-Hans;zh-CN;en-US</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zeitlind.Runtime\Zeitlind.Runtime.csproj" />
  </ItemGroup>
</Project>
